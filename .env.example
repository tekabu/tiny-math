# Copy to .env and adjust. Read by the server (npm start / pm2).

# Port the app listens on. Point cloudflared / Nginx Proxy Manager at http://localhost:<PORT>
PORT=3000

# 0.0.0.0 = reachable from other devices on the network (iPad/Android over Wi-Fi).
# 127.0.0.1 = only via the reverse proxy / tunnel on this machine (recommended on a VPS).
HOST=0.0.0.0

# Where the SQLite database lives (default: ./data). Back this folder up.
# DATA_DIR=/var/lib/tiny-math

# Which proxies may set X-Forwarded-For (used for login rate limiting).
# loopback = cloudflared or a proxy on the same machine.
# "loopback, uniquelocal" = Nginx Proxy Manager in Docker.
TRUST_PROXY=loopback
